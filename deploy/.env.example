# Copy to deploy/.env on the server and replace every password.
# deploy/.env is git-ignored; never commit it. Generate passwords with:
#   openssl rand -base64 24

POSTGRES_DB=certifind_db
POSTGRES_PORT=5432

# Superuser, for maintenance and backups only (not used by the app or importer).
POSTGRES_USER=certifind_admin
POSTGRES_PASSWORD=change-me-admin

# Owns the schema: Flyway migrations and the CSV importer log in as this role.
CERTIFIND_IMPORT_PASSWORD=change-me-import

# Read-only: the backend API logs in as this role.
CERTIFIND_APP_PASSWORD=change-me-app

# Port the API listens on, on 127.0.0.1 (the proxy service serves it publicly).
BACKEND_PORT=8080

# Public host name of the API, served over HTTPS by the proxy service. Its DNS
# record must point at this server before the certificate is requested.
API_DOMAIN=
# Contact address Let's Encrypt uses for expiry warnings.
LETSENCRYPT_EMAIL=

# Comma-separated browser origins allowed to call the API. For a same-origin
# reverse proxy, leave this empty or omit it; for a separate frontend, use its
# exact HTTPS origin, for example https://app.example.com. The prod profile refuses
# to start with an http://, localhost or example.* origin.
CERTIFIND_CORS_ALLOWED_ORIGINS=
