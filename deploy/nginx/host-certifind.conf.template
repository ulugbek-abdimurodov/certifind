# CertiFind site for a server whose ports 80/443 already belong to the host's nginx
# (shared with other sites). Used instead of the proxy service; installed by
# deploy/install-host-nginx.sh, which fills ${API_DOMAIN}, ${BACKEND_PORT} and
# ${FRONTEND_PORT} from deploy/.env. Same routes and limits as
# templates/certifind.conf.template; zone and upstream names are prefixed with
# certifind_ so they cannot clash with other sites.

limit_req_zone  $binary_remote_addr zone=certifind_api:10m       rate=10r/s;
limit_req_zone  $binary_remote_addr zone=certifind_search:10m    rate=2r/s;
limit_req_zone  $binary_remote_addr zone=certifind_directory:10m rate=12r/m;
limit_req_zone  $binary_remote_addr zone=certifind_web:10m       rate=20r/s;
limit_conn_zone $binary_remote_addr zone=certifind_perip:10m;

upstream certifind_api {
    server 127.0.0.1:${BACKEND_PORT};
    keepalive 16;
}
upstream certifind_web {
    server 127.0.0.1:${FRONTEND_PORT};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS (the install script leaves this out until the certificate exists) ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 16k;
    client_body_timeout   10s;
    client_header_timeout 10s;
    send_timeout          30s;
    limit_conn certifind_perip 20;
    limit_req_status  429;
    limit_conn_status 429;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout    30s;

    location = /api/v1/search {
        limit_req zone=certifind_search burst=10 nodelay;
        proxy_pass http://certifind_api;
    }
    location = /api/v1/companies {
        limit_req zone=certifind_directory burst=3 nodelay;
        proxy_pass http://certifind_api;
    }
    location /api/ {
        limit_req zone=certifind_api burst=40 nodelay;
        proxy_pass http://certifind_api;
    }
    location / {
        limit_req zone=certifind_web burst=80 nodelay;
        proxy_pass http://certifind_web;
    }

    error_page 429 = @too_many_requests;
    location @too_many_requests {
        default_type application/problem+json;
        add_header Retry-After 10 always;
        return 429 '{"type":"about:blank","title":"Troppe richieste","status":429,"detail":"Troppe richieste in poco tempo. Riprova tra qualche secondo."}';
    }
}
