# ==============================================================================
# Monorepo .gitignore for Certifind
# ==============================================================================

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Dependencies
node_modules/
.pnpm-store/
vendor/

# Build artifacts and targets (Rust / Maven / Cargo / Next / Webpack)
target/
dist/
build/
out/
.next/
.turbo/
*.class
*.jar
*.war

# IDE & Editor specific files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs and runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & local data volumes
pgdata/
*.sqlite
*.db
