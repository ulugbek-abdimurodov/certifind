# ==============================================================================
# Certifind Environment Configuration
# ==============================================================================

# PostgreSQL & pgvector Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=certifind_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Spring Boot database connection
DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# Comma-separated browser origins accepted by the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
