# ==============================================================================
# Certifind Environment Configuration
# Copy to .env and fill in values before running docker compose up.
# ==============================================================================

# PostgreSQL credentials — shared by both the postgres container and the backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=certifind_db

# Optional: set a real hostname to enable automatic HTTPS via Caddy + Let's Encrypt.
# Leave unset (or ":80") for plain HTTP on localhost.
# DOMAIN=certifind.example.com
