# Replaces the nginx image's default.conf (same output name): requests for any host
# other than ${API_DOMAIN}, such as scans of the bare IP, get no response at all.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}
